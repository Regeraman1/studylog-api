{
  "info": {
    "name": "StudyLog API Tests",
    "description": "Automated functional, negative and contract tests for the StudyLog REST API. Run in Postman or with `npm test` (Newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Responds in under 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
          "if (pm.response.code !== 204) {",
          "  pm.test(\"Content-Type is JSON\", () => pm.response.to.have.header(\"Content-Type\", \"application/json\"));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Health and authentication",
      "item": [
        {
          "name": "Health check is public",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Reports ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rejects request with no API key",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Explains the problem\", () => pm.expect(pm.response.json().error).to.match(/api key/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rejects request with wrong API key",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "not-the-key"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Session lifecycle (CRUD)",
      "item": [
        {
          "name": "Create a study session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"CSE 464\",\n  \"minutes\": 45,\n  \"date\": \"2026-10-18\",\n  \"notes\": \"Postman test scripts and assertions\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const s = pm.response.json();",
                  "pm.test(\"Matches the session schema\", () => pm.response.to.have.jsonSchema({",
                  "  type: \"object\",",
                  "  required: [\"id\", \"subject\", \"minutes\", \"date\", \"notes\", \"createdAt\"],",
                  "  properties: {",
                  "    id: { type: \"string\", minLength: 36 },",
                  "    subject: { type: \"string\" },",
                  "    minutes: { type: \"integer\", minimum: 1 },",
                  "    date: { type: \"string\", pattern: \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\" },",
                  "    notes: { type: \"string\" },",
                  "    createdAt: { type: \"string\" },",
                  "  },",
                  "}));",
                  "pm.test(\"Echoes the submitted values\", () => {",
                  "  pm.expect(s.subject).to.eql(\"CSE 464\");",
                  "  pm.expect(s.minutes).to.eql(45);",
                  "});",
                  "pm.test(\"Location header points to the new session\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(`/api/sessions/${s.id}`));",
                  "pm.collectionVariables.set(\"sessionId\", s.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Fetch the session by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{sessionId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the same session\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"sessionId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update minutes with PATCH",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{sessionId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"minutes\": 60\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = pm.response.json();",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Minutes changed\", () => pm.expect(s.minutes).to.eql(60));",
                  "pm.test(\"Other fields untouched\", () => {",
                  "  pm.expect(s.subject).to.eql(\"CSE 464\");",
                  "  pm.expect(s.date).to.eql(\"2026-10-18\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter list by subject (case-insensitive)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions?subject=cse%20464",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ],
              "query": [
                {
                  "key": "subject",
                  "value": "cse%20464"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const list = pm.response.json();",
                  "pm.test(\"Status 200 and an array\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(list).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Contains the created session\", () => pm.expect(list.map((s) => s.id)).to.include(pm.collectionVariables.get(\"sessionId\")));",
                  "pm.test(\"Only CSE 464 sessions returned\", () => list.forEach((s) => pm.expect(s.subject.toLowerCase()).to.eql(\"cse 464\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a second session for stats",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Swift\",\n  \"minutes\": 30,\n  \"date\": \"2026-10-19\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"notes defaults to empty string\", () => pm.expect(pm.response.json().notes).to.eql(\"\"));",
                  "pm.collectionVariables.set(\"secondSessionId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Stats add up to the session list",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "stats"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stats = pm.response.json();",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.sendRequest({",
                  "  url: pm.variables.replaceIn(\"{{baseUrl}}/api/sessions\"),",
                  "  header: { \"X-API-Key\": pm.variables.get(\"apiKey\") },",
                  "}, (err, res) => {",
                  "  const list = res.json();",
                  "  const sum = list.reduce((t, s) => t + s.minutes, 0);",
                  "  pm.test(\"totalSessions equals list length\", () => pm.expect(stats.totalSessions).to.eql(list.length));",
                  "  pm.test(\"totalMinutes equals sum of minutes\", () => pm.expect(stats.totalMinutes).to.eql(sum));",
                  "  pm.test(\"topSubject has the most minutes\", () => {",
                  "    const max = Math.max(...Object.values(stats.minutesBySubject));",
                  "    pm.expect(stats.minutesBySubject[stats.topSubject]).to.eql(max);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Validation (negative tests)",
      "item": [
        {
          "name": "Missing subject is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"minutes\": 20,\n  \"date\": \"2026-10-18\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Names the bad field\", () => pm.expect(pm.response.json().details.join(\" \")).to.include(\"subject\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Minutes sent as a string is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Math\",\n  \"minutes\": \"45\",\n  \"date\": \"2026-10-18\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Names the bad field\", () => pm.expect(pm.response.json().details.join(\" \")).to.include(\"minutes\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Minutes just over the limit (601) is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Math\",\n  \"minutes\": 601,\n  \"date\": \"2026-10-18\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Minutes at the limit (600) is accepted",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Math\",\n  \"minutes\": 600,\n  \"date\": \"2026-10-18\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"boundarySessionId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Impossible date (Feb 30) is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject\": \"Math\",\n  \"minutes\": 20,\n  \"date\": \"2026-02-30\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Names the bad field\", () => pm.expect(pm.response.json().details.join(\" \")).to.include(\"date\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed JSON body is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"subject\": \"Math\", "
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Says the JSON is invalid\", () => pm.expect(pm.response.json().error).to.match(/json/i));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH with an unknown field is rejected",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/{{sessionId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "{{sessionId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grade\": \"A\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Lists the unknown field\", () => pm.expect(pm.response.json().details.join(\" \")).to.include(\"grade\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown session id returns 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/sessions/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sessions",
                "does-not-exist"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
